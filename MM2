            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextColor3 = C.ACCENT,
            BorderSizePixel = 0,
            AutoButtonColor = false
        }, row)
        corner(dropBtn, 6)
        outline(dropBtn)

        local function setSelected(opt, silent)
            selected = opt
            for i, o in ipairs(currentOptions) do
                if o == opt then
                    optIndex = i
                    break
                end
            end
            dropBtn.Text = tostring(selected) .. " v"
            if not silent and callback then callback(selected) end
            if not isSyncingUI and AutoSaveConfig then
                AutoSaveConfig()
            end
        end

        local function setOptions(newOpts, preferred)
            currentOptions = {}
            for i, o in ipairs(newOpts or {}) do
                currentOptions[i] = o
            end
            if #currentOptions == 0 then
                currentOptions = {"None"}
            end
            local nextSel = currentOptions[1]
            if preferred then
                for _, o in ipairs(currentOptions) do
                    if o == preferred then
                        nextSel = preferred
                        break
                    end
                end
            end
            setSelected(nextSel, true)
        end

        dropBtn.MouseButton1Click:Connect(function()
            optIndex = optIndex + 1
            if optIndex > #currentOptions then optIndex = 1 end
            setSelected(currentOptions[optIndex], false)
        end)

        registerSearchable(row, getPageName(col), {title, tostring(defaultOption)})

        return {
            Row = row,
            SetSelected = function(opt) setSelected(opt, false) end,
            GetSelected = function() return selected end,
            SetOptions = setOptions
        }
    end

