local function getClosestKnifeTarget()
    local char = LocalPlayer.Character
    local root = getRootPart(char)
    if not root then return nil end

    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget = nil
    local bestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
            local tRoot = getRootPart(p.Character)
            if tRoot then
                local screenPos = Camera:WorldToViewportPoint(tRoot.Position)
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if (not Config.ShowFOV or dist <= Config.FOVRadius) and dist < bestDist then
                    bestDist = dist
                    bestTarget = p
                end
            end
        end
    end

    if not bestTarget then
        local minDist = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isPlayerAlive(p) and p.Character then
                local tRoot = getRootPart(p.Character)
                if tRoot then
                    local d = (root.Position - tRoot.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        bestTarget = p
                    end
                end
            end
        end
    end

    return bestTarget
end

local silentAimHookActive = true
if hookmetamethod and getnamecallmethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if silentAimHookActive and not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
            local remoteName = tostring(self.Name)
            local lremote = string.lower(remoteName)
            local isKnifeThrowRemote = (remoteName == "KnifeThrown") or string.find(lremote, "throw", 1, true)

            if isKnifeThrowRemote and (Config.KnifeSilentAim or Config.AutoSilentKnife or Config.SilentAim) then
                local args = {...}
                local target = getClosestKnifeTarget()
                if target and target.Character then
                    local tRoot = getRootPart(target.Character)
                    if tRoot then
                        local targetPos = computeKnifeAimPos(tRoot)
                        if targetPos then
                            if typeof(args[2]) == "CFrame" then
                                args[2] = CFrame.new(targetPos)
                            elseif typeof(args[2]) == "Vector3" then
                                args[2] = targetPos
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = CFrame.new(targetPos)
                            elseif typeof(args[1]) == "Vector3" then
                                args[1] = targetPos
                            else
                                args[2] = CFrame.new(targetPos)
                            end
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            elseif remoteName == "Shoot" and Config.SilentAim then
                local args = {...}
                local murderer = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and isPlayerAlive(p) and getPlayerRole(p) == "Murderer" then
                        murderer = p
                        break
                    end
                end
                if murderer and murderer.Character then
                    local mRoot = getRootPart(murderer.Character)
                    if mRoot then
                        local targetPos = computeKnifeAimPos(mRoot)
                        if targetPos then
                            args[2] = CFrame.new(targetPos)
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
            end
        end

        if setnamecallmethod then setnamecallmethod(method) end
        return oldNamecall(self, ...)
    end))
end

