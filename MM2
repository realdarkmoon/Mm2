local function isPlayerAlive(p)
    if not p or not p.Character then return false end
    local hum = getHumanoid(p.Character)
    return hum ~= nil and hum.Health > 0
end

local function hasRoleTool(container, roleKind)
    if not container then return false end
    for _, item in ipairs(container:GetChildren()) do
        if item:IsA("Tool") or item:IsA("Folder") then
            local lname = string.lower(item.Name)
            if roleKind == "Murderer" then
                if item.Name == "Knife" or string.find(lname, "knife", 1, true) or string.find(lname, "blade", 1, true) or item:FindFirstChild("KnifeScript") or item:FindFirstChild("KnifeLocal") then
                    return true
                end
            elseif roleKind == "Sheriff" then
                if item.Name == "Gun" or string.find(lname, "gun", 1, true) or string.find(lname, "revolver", 1, true) or string.find(lname, "pistol", 1, true) or item:FindFirstChild("GunScript") or item:FindFirstChild("GunLocal") then
                    return true
                end
            end
        end
    end
    return false
end

local function getKnifeTool(char)
    local bp = LocalPlayer and LocalPlayer:FindFirstChild("Backpack")
    local containers = {}
    if char then table.insert(containers, char) end
    if bp then table.insert(containers, bp) end

    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local lname = string.lower(item.Name)
                if item.Name == "Knife"
                    or string.find(lname, "knife", 1, true)
                    or string.find(lname, "blade", 1, true)
                    or item:FindFirstChild("KnifeScript")
                    or item:FindFirstChild("KnifeLocal") then
                    return item, container
                end
            end
        end
    end
    return nil, nil
end

local function getKnifeThrowRemote(knife)
    if not knife then return nil end
    local events = knife:FindFirstChild("Events")
    if events then
        local direct = events:FindFirstChild("KnifeThrown")
        if direct and (direct:IsA("RemoteEvent") or direct:IsA("RemoteFunction")) then
            return direct
        end
        for _, child in ipairs(events:GetDescendants()) do
            if (child:IsA("RemoteEvent") or child:IsA("RemoteFunction")) then
                local lname = string.lower(child.Name)
                if string.find(lname, "throw", 1, true) or string.find(lname, "knife", 1, true) then
                    return child
                end
            end
        end
    end

    local directKnife = knife:FindFirstChild("KnifeThrown", true)
    if directKnife and (directKnife:IsA("RemoteEvent") or directKnife:IsA("RemoteFunction")) then
        return directKnife
    end

    for _, desc in ipairs(knife:GetDescendants()) do
        if (desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction")) and string.find(string.lower(desc.Name), "throw", 1, true) then
            return desc
        end
    end

    return nil
end

local function getKnifeOriginPart(knife, root)
    if knife then
        for _, name in ipairs({"Handle", "Blade", "Part"}) do
            local found = knife:FindFirstChild(name)
            if found and found:IsA("BasePart") then
                return found
            end
        end
        local anyPart = knife:FindFirstChildWhichIsA("BasePart", true)
        if anyPart then
            return anyPart
        end
    end
    return root
end

local function computeKnifeAimPos(targetRoot)
    if not targetRoot then return nil end
    local pos = targetRoot.Position
    if Config.AimPrediction then
        local lead = Config.PingComp and 0.16 or 0.12
        pos = pos + (targetRoot.AssemblyLinearVelocity * lead)
    end
    return pos
end

local function fireKnifeThrowRemote(remote, originCF, targetPos)
    if not remote or not originCF or not targetPos then return false end
    local targetCF = CFrame.new(targetPos)
    local ok = false

    if remote:IsA("RemoteEvent") then
        ok = pcall(function() remote:FireServer(originCF, targetCF) end)
        if not ok then
            ok = pcall(function() remote:FireServer(originCF, targetPos) end)
        end
        if not ok then
            ok = pcall(function() remote:FireServer(targetCF) end)
        end
    elseif remote:IsA("RemoteFunction") then
        ok = pcall(function() remote:InvokeServer(originCF, targetCF) end)
        if not ok then
            ok = pcall(function() remote:InvokeServer(originCF, targetPos) end)
        end
    end

    return ok
end

local function getPlayerRole(p)
    if not p then return "Innocent" end

    local attrRole = p:GetAttribute("Role") or (p.Character and p.Character:GetAttribute("Role"))
    if type(attrRole) == "string" then
        local lrole = string.lower(attrRole)
        if string.find(lrole, "murd", 1, true) then
            return "Murderer"
        elseif string.find(lrole, "sher", 1, true) or string.find(lrole, "hero", 1, true) then
            return "Sheriff"
        end
    end

    local bp = p:FindFirstChild("Backpack")
    local char = p.Character
    local starterGear = p:FindFirstChild("StarterGear")

    if hasRoleTool(bp, "Murderer") or hasRoleTool(char, "Murderer") or hasRoleTool(starterGear, "Murderer") then
        return "Murderer"
    end
    if hasRoleTool(bp, "Sheriff") or hasRoleTool(char, "Sheriff") or hasRoleTool(starterGear, "Sheriff") then
        return "Sheriff"
    end

    return "Innocent"
end

local function getRolePlayers()
    local murderer = nil
    local sheriff = nil
    local innocents = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isPlayerAlive(p) then
            local r = getPlayerRole(p)
            if r == "Murderer" then
                murderer = p
            elseif r == "Sheriff" then
                sheriff = p
            else
                table.insert(innocents, p)
            end
        end
    end
    return murderer, sheriff, innocents
end

