if not ok then
    warn("[DARK MOON V 1.2] Failed to load: " .. tostring(err))
    pcall(function()
        local p = game:GetService("Players").LocalPlayer
        local errGui = Instance.new("ScreenGui")
        errGui.Name = "DarkMoonError"
        errGui.ResetOnSpawn = false
        errGui.Parent = p:WaitForChild("PlayerGui")

        local box = Instance.new("TextButton")
        box.Size = UDim2.fromOffset(560, 160)
        box.AnchorPoint = Vector2.new(0.5, 0.5)
        box.Position = UDim2.fromScale(0.5, 0.5)
        box.BackgroundColor3 = Color3.fromRGB(34, 12, 18)
        box.TextColor3 = Color3.new(1, 1, 1)
        box.TextWrapped = true
        box.TextSize = 14
        box.Font = Enum.Font.Gotham
        box.Text = "DARK MOON V 1.2 failed to load:\n\n" .. tostring(err) .. "\n\nClick to close"
        box.Parent = errGui
        box.MouseButton1Click:Connect(function()
            errGui:Destroy()
        end)
    end)
end
