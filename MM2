local function cleanupFlingMovers(root)
    if not root then return end
    for _, obj in ipairs(root:GetChildren()) do
        if obj:IsA("BodyMover") or obj:IsA("Constraint") then
            if obj.Name == "FlingTorque" or obj.Name == "FlingVelocity" or obj.Name == "FlingAlignPos" then
                pcall(function() obj:Destroy() end)
            end
        end
    end
end

local function refreshFlingOwnership()
    if sethiddenproperty then
        pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
        pcall(sethiddenproperty, LocalPlayer, "MaxSimulationRadius", math.huge)
    end
    if setsimulationradius then
        pcall(setsimulationradius, math.huge, math.huge)
    end
end

local function flingCharacter(targetPlayerOrChar)
    if isFlinging then return end

    local targetPlayer = nil
    local initialTargetChar = nil
    if typeof(targetPlayerOrChar) == "Instance" and targetPlayerOrChar:IsA("Player") then
        targetPlayer = targetPlayerOrChar
        initialTargetChar = targetPlayer.Character
    elseif typeof(targetPlayerOrChar) == "Instance" and targetPlayerOrChar:IsA("Model") then
        initialTargetChar = targetPlayerOrChar
        targetPlayer = Players:GetPlayerFromCharacter(initialTargetChar)
    end

    local char = LocalPlayer.Character
    local root = getRootPart(char)
    local tChar = (targetPlayer and targetPlayer.Character) or initialTargetChar
    local tRoot = getRootPart(tChar)
    if not root or not tRoot then return end

    local hum = getHumanoid(char)
    local tHum = getHumanoid(tChar)
    if not hum or hum.Health <= 0 or not tHum or tHum.Health <= 0 then return end

    isFlinging = true
    local oldCF = root.CFrame
    local oldState = hum:GetState()
    local oldWalkSpeed = hum.WalkSpeed
    local oldJumpPower = hum.JumpPower

    local function restoreState()
        local curChar = LocalPlayer.Character
        local curRoot = getRootPart(curChar)
        local curHum = getHumanoid(curChar)
        cleanupFlingMovers(curRoot)
        if curRoot and curRoot.Parent then
            pcall(function()
                curRoot.AssemblyLinearVelocity = Vector3.zero
                curRoot.AssemblyAngularVelocity = Vector3.zero
                curRoot.CFrame = oldCF
            end)
        end
        if curChar and curChar.Parent then
            for _, child in ipairs(curChar:GetDescendants()) do
                if child:IsA("BasePart") then
                    pcall(function()
                        child.Massless = false
                        if child.Name == "HumanoidRootPart" then
                            child.CanCollide = false
                        end
                    end)
                end
            end
        end
        if curHum and curHum.Parent and curHum.Health > 0 then
            pcall(function()
                curHum.WalkSpeed = oldWalkSpeed
                curHum.JumpPower = oldJumpPower
                curHum:ChangeState(oldState or Enum.HumanoidStateType.GettingUp)
            end)
        end
        isFlinging = false
    end

    local ranOk, runErr = pcall(function()
        local power = math.max(tonumber(Config.FlingPower) or 110, 25)
        local spinVel = math.max(power * 340, 45000)
        local launchMag = math.max(power * 145, 16000)

        refreshFlingOwnership()
        cleanupFlingMovers(root)

        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end)

        local bAV = Instance.new("BodyAngularVelocity")
        bAV.Name = "FlingTorque"
        bAV.AngularVelocity = Vector3.new(spinVel * 0.9, spinVel * 1.9, spinVel * 0.9)
        bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bAV.P = 1e9
        bAV.Parent = root

        local bV = Instance.new("BodyVelocity")
        bV.Name = "FlingVelocity"
        bV.Velocity = Vector3.new(0, launchMag * 0.85, 0)
        bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bV.P = 1e9
        bV.Parent = root

        local steppedConn = RunService.Stepped:Connect(function()
            local cNow = LocalPlayer.Character
            if cNow and cNow.Parent then
                for _, child in ipairs(cNow:GetDescendants()) do
                    if child:IsA("BasePart") then
                        child.CanCollide = false
                        child.Massless = true
                    end
                end
            end
            local liveTargetChar = (targetPlayer and targetPlayer.Character) or tChar
            if liveTargetChar and liveTargetChar.Parent then
                for _, tChild in ipairs(liveTargetChar:GetDescendants()) do
                    if tChild:IsA("BasePart") then
                        tChild.CanCollide = false
                    end
                end
            end
        end)

        local startTime = tick()
        local duration = 2.0

        while tick() - startTime < duration do
            char = LocalPlayer.Character
            root = getRootPart(char)
            hum = getHumanoid(char)
            tChar = (targetPlayer and targetPlayer.Character) or initialTargetChar
            tRoot = getRootPart(tChar)
            tHum = getHumanoid(tChar)

            if not tChar or not tChar.Parent or not tRoot or not tRoot.Parent or not tHum or tHum.Health <= 0 then
                break
            end
            if not char or not char.Parent or not root or not root.Parent or not hum or hum.Health <= 0 then
                break
            end

            if bAV.Parent ~= root then bAV.Parent = root end
            if bV.Parent ~= root then bV.Parent = root end
            refreshFlingOwnership()

            local elapsed = tick() - startTime
            local style = Config.FlingStyle
            local targetVel = tRoot.AssemblyLinearVelocity or Vector3.zero
            local leadPos = tRoot.Position + (targetVel * 0.2)

            if style == "Velocity" then
                local surgeX = math.sin(elapsed * 44) * launchMag
                local surgeZ = math.cos(elapsed * 44) * launchMag
                local surgeY = launchMag * (0.95 + 0.35 * math.sin(elapsed * 26))
                root.CFrame = CFrame.new(leadPos + Vector3.new(0, 0.2, 0))
                bV.Velocity = Vector3.new(surgeX, surgeY, surgeZ)
                bAV.AngularVelocity = Vector3.new(spinVel, spinVel * 1.5, spinVel)
                root.AssemblyLinearVelocity = bV.Velocity
                root.AssemblyAngularVelocity = bAV.AngularVelocity
            elseif style == "Torque" then
                local snap = Vector3.new(
                    math.sin(elapsed * 58) * 0.55,
                    math.cos(elapsed * 50) * 0.4,
                    math.cos(elapsed * 58) * 0.55
                )
                root.CFrame = CFrame.new(leadPos + snap) * CFrame.Angles(elapsed * 24, elapsed * 36, elapsed * 20)
                bV.Velocity = Vector3.new(
                    math.cos(elapsed * 40) * launchMag,
                    launchMag * 1.1,
                    math.sin(elapsed * 40) * launchMag
                )
                bAV.AngularVelocity = Vector3.new(spinVel * 1.25, spinVel * 2.1, spinVel * 1.25)
                root.AssemblyLinearVelocity = bV.Velocity
                root.AssemblyAngularVelocity = bAV.AngularVelocity
            else
                local angle = elapsed * 36
                local radius = 1.2
                local orbitOffset = Vector3.new(
                    math.cos(angle) * radius,
                    math.sin(elapsed * 24) * 0.85,
                    math.sin(angle) * radius
                )
                root.CFrame = CFrame.new(leadPos + orbitOffset, leadPos)
                bV.Velocity = Vector3.new(
                    math.cos(angle) * launchMag * 1.15,
                    launchMag * 1.05,
                    math.sin(angle) * launchMag * 1.15
                )
                bAV.AngularVelocity = Vector3.new(spinVel * 1.1, spinVel * 1.85, spinVel * 1.1)
                root.AssemblyLinearVelocity = bV.Velocity
                root.AssemblyAngularVelocity = bAV.AngularVelocity
            end

            RunService.Heartbeat:Wait()
        end

        pcall(function() steppedConn:Disconnect() end)
        pcall(function() bAV:Destroy() end)
        pcall(function() bV:Destroy() end)
    end)

    restoreState()
    if not ranOk then
        warn("[Fling V2] Recovering from error: " .. tostring(runErr))
    end
end

