            TextXAlignment = Enum.TextXAlignment.Left
        }, row)

        local currentOptions = {}
        for i, o in ipairs(options or {}) do
            currentOptions[i] = o
        end
        if #currentOptions == 0 then
            currentOptions = {"None"}
        end

        local selected = defaultOption or currentOptions[1]
        local optIndex = 1
        for i, o in ipairs(currentOptions) do
            if o == selected then
                optIndex = i
                break
            end
        end

        local dropBtn = make("TextButton", {
            Size = UDim2.new(0.44, -10, 0, 26),
            Position = UDim2.new(0.54, 0, 0.5, -13),
            BackgroundColor3 = C.chip,
