function AetherSim.WorldMock:_seed_entities(count)
    local names = {
        "Valkyrie_01", "Kestrel_Bot", "Cinder_X", "EchoRunner",
        "Bastion_9", "NyxShade", "RookDelta", "ZephyrUnit",
        "PulseStrider", "CobaltFox", "GoliathMK2", "WardenLite"
    }
    for i = 1, count do
        local dist = self.rng:range(18.0, 140.0)
        local angle = math.rad(self.rng:range(-32.0, 32.0))
        local px = math.sin(angle) * dist
        local pz = math.cos(angle) * dist
        self.entities[i] = {
            id = i,
            name = names[((i - 1) % #names) + 1],
            team = (i % 5 == 0) and "ALLIED" or "HOSTILE",
            hp = self.rng:int(25, 100),
            max_hp = 100,
            alive = true,
            visible_mock = self.rng:chance(0.75),
            pos = { x = px, y = 0.0, z = pz },
            vel = {
                x = self.rng:range(-4.5, 4.5),
                y = 0.0,
                z = self.rng:range(-2.5, 2.5),
            },
        }
    end
end

function AetherSim.WorldMock:step(dt_sec)
    -- Advance simulated targets along smooth paths
    for _, ent in ipairs(self.entities) do
        if ent.alive then
            ent.pos.x = ent.pos.x + ent.vel.x * dt_sec
            ent.pos.z = ent.pos.z + ent.vel.z * dt_sec

            -- Bounce gently within mock arena bounds
            if math.abs(ent.pos.x) > 85.0 then
                ent.vel.x = -ent.vel.x
                ent.pos.x = AetherSim.Math.clamp(ent.pos.x, -85.0, 85.0)
            end
            if ent.pos.z < 10.0 or ent.pos.z > 180.0 then
                ent.vel.z = -ent.vel.z
                ent.pos.z = AetherSim.Math.clamp(ent.pos.z, 10.0, 180.0)
            end

            if self.rng:chance(0.03) then
                ent.vel.x = self.rng:range(-5.0, 5.0)
                ent.visible_mock = self.rng:chance(0.78)
            end
        end
    end
end

function AetherSim.WorldMock:get_bone_world_pos(ent, bone_name)
    local cfg = AetherSim.Config.bone_offsets_local[bone_name] or AetherSim.Config.bone_offsets_local.Head
    return {
        x = ent.pos.x + cfg.x,
        y = ent.pos.y + cfg.y,
        z = ent.pos.z + cfg.z,
    }
end

function AetherSim.WorldMock:select_best_target(cfg, locked_id)
    local best = nil
    local best_score = math.huge

    for _, ent in ipairs(self.entities) do
        local eligible = ent.alive and ent.hp > 0
        if cfg.aimbot.ignore_teammates and ent.team == "ALLIED" then
            eligible = false
        end
        if cfg.aimbot.visibility_check_mock and not ent.visible_mock then
            eligible = false
        end

        local dist_3d = AetherSim.Math.dist3(self.camera.pos, ent.pos)
        if dist_3d > cfg.aimbot.max_target_distance_m then
            eligible = false
        end

        if eligible then
            local bone_name = cfg.aimbot.target_bone
            if cfg.aimbot.bone_switch_on_low_hp and ent.hp <= cfg.aimbot.low_hp_threshold then
                bone_name = cfg.aimbot.fallback_bone
            end

            local bone_world = self:get_bone_world_pos(ent, bone_name)
            local screen_pt, on_screen = AetherSim.Math.world_to_screen_mock(
                bone_world,
                self.camera.pos,
                self.camera.forward,
                self.screen.width,
                self.screen.height,
                self.screen.fov_deg
            )

            if screen_pt and on_screen then
                local fov_dist = AetherSim.Math.dist2(self.crosshair, screen_pt)
                local active_fov = cfg.aimbot.fov_radius_px
                if cfg.aimbot.dynamic_fov then
                    active_fov = AetherSim.Math.clamp(
                        1800.0 / math.max(dist_3d, 5.0),
                        cfg.aimbot.min_fov_px,
                        cfg.aimbot.max_fov_px
                    )
                end

                if fov_dist <= active_fov then
                    local score = fov_dist + (dist_3d * 0.15)
                    if locked_id and ent.id == locked_id then
                        score = score * 0.72 -- Hysteresis bonus for sticky target
                    end
                    if score < best_score then
                        best_score = score
                        best = {
                            entity = ent,
                            bone_name = bone_name,
                            bone_world = bone_world,
                            screen_pt = screen_pt,
                            fov_dist = fov_dist,
                            active_fov = active_fov,
                            dist_3d = dist_3d,
                            score = score,
                        }
                    end
                end
            end
        end
    end

    return best
end

