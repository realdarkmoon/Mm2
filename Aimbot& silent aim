                    "SHOT#%03d [%s] -> %s (%s) dmg=%d hp=%d",
                    res.shot.shot_id,
                    res.shot.outcome,
                    res.shot.target_name,
                    res.shot.bone,
                    res.shot.damage_mock,
                    res.shot.hp_after
                )
            end
            engine:record_trace(string.format(
                "[TRACE %04d] xhair=(%6.1f,%6.1f) delta=(%+5.2f,%%+5.2f) tgt=%-12s bone=%-10s fov=%.1f/%.1f dist=%.1fm | %s",
                step_idx,
                engine.world.crosshair.x,
                engine.world.crosshair.y,
                res.dx,
                res.dy,
                t_info.entity.name,
                t_info.bone_name,
                t_info.fov_dist,
                t_info.active_fov,
                t_info.dist_3d,
                shot_str
            ))
        else
            engine:record_trace(string.format(
                "[TRACE %04d] xhair=(%6.1f,%6.1f) delta=( +0.00, +0.00) tgt=NONE         bone=N/A        fov=0.0/145.0 dist=0.0m | SCANNING_MOCK_FOV",
                step_idx,
                engine.world.crosshair.x,
                engine.world.crosshair.y
            ))
        end
    end
end

