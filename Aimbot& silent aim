function AetherSim.RNG.new(seed)
    local self = setmetatable({}, AetherSim.RNG)
    self.state = (tonumber(seed) or 1337) % 2147483647
    if self.state <= 0 then
        self.state = 123456789
    end
    return self
end

function AetherSim.RNG:next_uint()
    -- Park-Miller LCG for deterministic simulation output
    self.state = (self.state * 16807) % 2147483647
    return self.state
end

function AetherSim.RNG:next_float()
    return (self:next_uint() - 1) / 2147483646.0
end

function AetherSim.RNG:range(min_val, max_val)
    if max_val < min_val then
        min_val, max_val = max_val, min_val
    end
    return min_val + (max_val - min_val) * self:next_float()
end

function AetherSim.RNG:int(min_val, max_val)
    return math.floor(self:range(min_val, max_val + 0.999999))
end

function AetherSim.RNG:chance(prob_0_to_1)
    return self:next_float() < prob_0_to_1
end

