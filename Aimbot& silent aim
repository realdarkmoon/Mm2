function AetherSim.Math.add3(a, b)
    return { x = a.x + b.x, y = a.y + b.y, z = a.z + b.z }
end

function AetherSim.Math.sub3(a, b)
    return { x = a.x - b.x, y = a.y - b.y, z = a.z - b.z }
end

function AetherSim.Math.scale3(v, s)
    return { x = v.x * s, y = v.y * s, z = v.z * s }
end

function AetherSim.Math.dot3(a, b)
    return a.x * b.x + a.y * b.y + a.z * b.z
end

function AetherSim.Math.len3(v)
    return math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
end

function AetherSim.Math.dist3(a, b)
    return AetherSim.Math.len3(AetherSim.Math.sub3(a, b))
end

function AetherSim.Math.norm3(v)
    local l = AetherSim.Math.len3(v)
    if l < 1e-8 then
        return { x = 0.0, y = 0.0, z = 0.0 }
    end
    return { x = v.x / l, y = v.y / l, z = v.z / l }
end

function AetherSim.Math.dist2(a, b)
    local dx = a.x - b.x
    local dy = a.y - b.y
    return math.sqrt(dx * dx + dy * dy)
end

function AetherSim.Math.clamp(val, lo, hi)
    if val < lo then return lo end
    if val > hi then return hi end
    return val
end

function AetherSim.Math.lerp(a, b, t)
    return a + (b - a) * AetherSim.Math.clamp(t, 0.0, 1.0)
end

function AetherSim.Math.bezier2(p0, p1, p2, t)
    local u = 1.0 - t
    local x = u * u * p0.x + 2.0 * u * t * p1.x + t * t * p2.x
    local y = u * u * p0.y + 2.0 * u * t * p1.y + t * t * p2.y
    return { x = x, y = y }
end

function AetherSim.Math.compute_travel_time(origin, target_pos, bullet_speed_mps)
    local dist = AetherSim.Math.dist3(origin, target_pos)
    local speed = math.max(bullet_speed_mps, 50.0)
    return dist / speed
end

function AetherSim.Math.predict_position(origin, target_pos, target_vel, bullet_speed_mps, gravity_mps2, ping_ms)
    local ping_sec = (ping_ms or 0.0) / 1000.0
    local t_flight = AetherSim.Math.compute_travel_time(origin, target_pos, bullet_speed_mps) + ping_sec
    -- Iterative refinement for moving targets
    for _ = 1, 2 do
        local candidate = AetherSim.Math.add3(target_pos, AetherSim.Math.scale3(target_vel, t_flight))
        t_flight = AetherSim.Math.compute_travel_time(origin, candidate, bullet_speed_mps) + ping_sec
    end

    local predicted = AetherSim.Math.add3(target_pos, AetherSim.Math.scale3(target_vel, t_flight))
    if gravity_mps2 and gravity_mps2 > 0.0 then
        -- Aim slightly higher to offset simulated drop
        predicted.y = predicted.y + 0.5 * gravity_mps2 * (t_flight * t_flight)
    end
    return predicted, t_flight
end

function AetherSim.Math.world_to_screen_mock(world_pos, cam_pos, cam_forward, screen_w, screen_h, fov_deg)
    local to_point = AetherSim.Math.sub3(world_pos, cam_pos)
    local forward_norm = AetherSim.Math.norm3(cam_forward)
    local depth = AetherSim.Math.dot3(to_point, forward_norm)
    if depth <= 0.25 then
        return nil, false
    end

    local up_ref = { x = 0.0, y = 1.0, z = 0.0 }
    local right_x = forward_norm.y * up_ref.z - forward_norm.z * up_ref.y
    local right_y = forward_norm.z * up_ref.x - forward_norm.x * up_ref.z
    local right_z = forward_norm.x * up_ref.y - forward_norm.y * up_ref.x
    local right = AetherSim.Math.norm3({ x = right_x, y = right_y, z = right_z })
    local up = {
        x = right.y * forward_norm.z - right.z * forward_norm.y,
        y = right.z * forward_norm.x - right.x * forward_norm.z,
        z = right.x * forward_norm.y - right.y * forward_norm.x,
    }

    local rx = AetherSim.Math.dot3(to_point, right)
    local uy = AetherSim.Math.dot3(to_point, up)

    local half_fov_rad = math.rad((fov_deg or 90.0) * 0.5)
    local tan_half = math.tan(half_fov_rad)
    local aspect = (screen_w or 1920) / math.max((screen_h or 1080), 1)

    local ndc_x = (rx / (depth * tan_half * aspect))
    local ndc_y = (uy / (depth * tan_half))

    local sx = (ndc_x * 0.5 + 0.5) * (screen_w or 1920)
    local sy = (-ndc_y * 0.5 + 0.5) * (screen_h or 1080)

    local on_screen = (sx >= 0 and sx <= (screen_w or 1920) and sy >= 0 and sy <= (screen_h or 1080))
    return { x = sx, y = sy, depth = depth }, on_screen
end

