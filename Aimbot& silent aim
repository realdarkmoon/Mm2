function AetherSim:compute_aimbot_delta(target_info, dt_sec)
    local cfg = AetherSim.Config
    local cur = self.world.crosshair
    local goal = { x = target_info.screen_pt.x, y = target_info.screen_pt.y }

    if cfg.humanization.enabled then
        if self.rng:chance(cfg.humanization.overshoot_chance) then
            goal.x = goal.x + self.rng:range(-cfg.humanization.overshoot_amount_px, cfg.humanization.overshoot_amount_px)
            goal.y = goal.y + self.rng:range(-cfg.humanization.overshoot_amount_px, cfg.humanization.overshoot_amount_px)
        end
        goal.x = goal.x + self.rng:range(-cfg.humanization.micro_jitter_px, cfg.humanization.micro_jitter_px)
        goal.y = goal.y + self.rng:range(-cfg.humanization.micro_jitter_px, cfg.humanization.micro_jitter_px)
    end

    local dx = goal.x - cur.x
    local dy = goal.y - cur.y
    local mag = math.sqrt(dx * dx + dy * dy)

    if mag <= cfg.aimbot.deadzone_px then
        return 0.0, 0.0
    end

    local step_x = dx * cfg.aimbot.smooth_x * math.min(dt_sec * 60.0, 2.5)
    local step_y = dy * cfg.aimbot.smooth_y * math.min(dt_sec * 60.0, 2.5)

    if cfg.aimbot.mode == "BEZIER" then
        local mid = {
            x = (cur.x + goal.x) * 0.5 + self.rng:range(-12.0, 12.0),
            y = (cur.y + goal.y) * 0.5 + self.rng:range(-12.0, 12.0),
        }
        local b_pt = AetherSim.Math.bezier2(cur, mid, goal, AetherSim.Math.clamp(cfg.aimbot.smooth_x, 0.05, 0.95))
        step_x = b_pt.x - cur.x
        step_y = b_pt.y - cur.y
    elseif cfg.aimbot.mode == "INSTANT" then
        step_x = dx
        step_y = dy
    end

    local max_step = cfg.limits.max_smooth_step_px
    step_x = AetherSim.Math.clamp(step_x, -max_step, max_step)
    step_y = AetherSim.Math.clamp(step_y, -max_step, max_step)

    return step_x, step_y
end

function AetherSim:simulate_silent_aim_shot(target_info)
    local cfg = AetherSim.Config
    self.shots_fired = self.shots_fired + 1

    local ent = target_info.entity
    local predicted_world, t_flight = AetherSim.Math.predict_position(
        self.world.camera.pos,
        target_info.bone_world,
        ent.vel,
        cfg.silent_aim.bullet_speed_mps,
        cfg.silent_aim.gravity_compensation and cfg.silent_aim.gravity_accel_mps2 or 0.0,
        cfg.silent_aim.ping_compensation_ms
    )

    local hit_prob = cfg.silent_aim.hit_chance_percent / 100.0
    local is_hit = self.rng:chance(hit_prob)
    local final_point = {
        x = predicted_world.x,
        y = predicted_world.y,
        z = predicted_world.z,
    }

    if is_hit then
        self.silent_hits_mock = self.silent_hits_mock + 1
        local dmg = self.rng:int(22, 48)
        ent.hp = math.max(0, ent.hp - dmg)
        if ent.hp == 0 then
            ent.alive = false
        end
        return {
            shot_id = self.shots_fired,
            outcome = "MOCK_HIT",
            target_name = ent.name,
            bone = target_info.bone_name,
            t_flight = t_flight,
            aim_point = final_point,
            damage_mock = dmg,
            hp_after = ent.hp,
        }
    else
        self.silent_misses_mock = self.silent_misses_mock + 1
        local spread = cfg.silent_aim.miss_spread_deg * 0.15
        final_point.x = final_point.x + self.rng:range(-spread, spread)
        final_point.y = final_point.y + self.rng:range(-spread, spread)
        final_point.z = final_point.z + self.rng:range(-spread, spread)
        return {
            shot_id = self.shots_fired,
            outcome = "MOCK_MISS",
            target_name = ent.name,
            bone = target_info.bone_name,
            t_flight = t_flight,
            aim_point = final_point,
            damage_mock = 0,
            hp_after = ent.hp,
        }
    end
end

function AetherSim:step_frame(dt_sec)
    self.tick_count = self.tick_count + 1
    self.world:step(dt_sec)

    local target = self.world:select_best_target(AetherSim.Config, self.locked_target_id)
    local dx, dy = 0.0, 0.0
    local shot_res = nil

    if target then
        self.locked_target_id = target.entity.id
        self.lock_elapsed_ms = self.lock_elapsed_ms + (dt_sec * 1000.0)

        if AetherSim.Config.aimbot.enabled then
            dx, dy = self:compute_aimbot_delta(target, dt_sec)
            self.world.crosshair.x = AetherSim.Math.clamp(self.world.crosshair.x + dx, 0.0, self.world.screen.width)
            self.world.crosshair.y = AetherSim.Math.clamp(self.world.crosshair.y + dy, 0.0, self.world.screen.height)
        end

        if AetherSim.Config.silent_aim.enabled and (self.tick_count % 4 == 0) then
            shot_res = self:simulate_silent_aim_shot(target)
        end
    else
        self.locked_target_id = nil
        self.lock_elapsed_ms = 0.0
    end

    return {
        tick = self.tick_count,
        target = target,
        dx = dx,
        dy = dy,
        shot = shot_res,
    }
end

